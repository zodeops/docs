{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Zode",
  "description": "Linux VMs for coding agents. Start a sandbox, run commands, fork it, and pay per vCPU-hour.",
  "colors": {
    "primary": "#0f8a3c",
    "light": "#00ff4f",
    "dark": "#0b4a22"
  },
  "background": {
    "color": {
      "light": "#f4f8f3",
      "dark": "#050706"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://zode.dev"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@zode.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://console.zode.dev"
    }
  },
